<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradient Background -->
    <item>
        <shape>
            <gradient
                android:angle="45"
                android:startColor="#FF9800"
                android:endColor="#FFC107" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Shadow Layer -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape>
            <solid android:color="#80000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
