<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Normal State -->
    <item android:state_pressed="false">
        <layer-list>
            <!-- Outer Glow Effect -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#BF9400D3" /> <!-- Neon purple glow -->
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- Shadow Layer -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#202020" /> <!-- Dark shadow -->
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- Main Button Layer -->
            <item android:top="8dp" android:left="8dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#FFD700"
                    android:endColor="#FF8C00"
                    android:angle="270" />
                    <corners android:radius="20dp" />
                    <stroke android:width="4dp" android:color="#FFD700" /> <!-- Gold border -->
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Outer Glow Effect -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#BF00FFFF" /> <!-- Neon blue glow -->
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- Shadow Layer -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2B2B2B" /> <!-- Slightly lighter shadow -->
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- Main Button Layer -->
            <item android:top="4dp" android:left="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#1E90FF"
                    android:endColor="#00008B"
                    android:angle="270" />
                    <corners android:radius="20dp" />
                    <stroke android:width="4dp" android:color="#1E90FF" /> <!-- Neon blue border -->
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
